# Session entry point: ephemeral by design, rewritten each session.
START_HERE.md

# Worktrees the harness makes for a delegated agent, which sit inside the
# repository. A copy of the tree here is read by every checker that walks the
# working directory, so the suppression register reports the copy's pragmas as
# unregistered under a path no entry names.
.claude/worktrees/

# In-process and working files, including the message a commit is given with
# -F. Gitignored so that naming it on the command line can never put it into
# the commit it describes.
.ephemera/

# Python build and cache artifacts. The pack is installed editable, so the
# egg-info lands beside the source rather than in a build directory.
#
# `build/` is here because building a wheel to check what it carries leaves one,
# and the gate then grades it: `analyse` and `types` both fail against copied
# sources under `python/build/`. The walk honours gitignore,
# so ignoring it keeps the gate measuring the pack and not a copy.
__pycache__/
*.egg-info/
build/

# bolt writes its evidence to .bolt-<iso8601> at the base unless told otherwise,
# so a run from the repository root leaves one of these behind. Run it with
# --output-dir .ephemera/gate to keep evidence where working files belong.
.bolt-*/

# Rust build output. Cargo.lock is committed for a binary and omitted for a
# library, and this is a library, so a consumer resolves its own versions.
rust/target/
rust/Cargo.lock

# The TypeScript pack's installed dependencies. `package-lock.json` is committed
# and is what pins them, so this directory is reproducible from the tree and
# carrying it would add tens of thousands of files nobody reads.
#
# Unanchored, so it matches wherever a Node project appears. `bolt` does not
# read this file, so a jig task that walks the tree still has to exclude
# `**/node_modules/**` for itself; the two are separate statements.
node_modules/

# C++ build output. The build directory itself is covered by the `build/`
# pattern above; this is the compilation database, a symlink into it that `just
# cpp-profile` remakes. The jig's contract is that a build writes the database,
# so committing one would encode a path a clone resolves to nothing.
cpp/compile_commands.json

# The libraries the C++ pack binds, fetched at the tags
# `which-libraries-the-cpp-pack-binds` names. They sit beside the source rather
# than under `build/`, which `just cpp-profile` empties on every run, because a
# pinned tree is not build output and re-cloning it per run costs minutes. The
# CMake file is what pins them, so nothing here needs committing.
cpp/.deps/

# coverage writes this beside the pack when the shared jig runs its tests
.coverage
python/.coverage

# The adopted jig links. `toolbox/jigs.yaml` declares the set and `link-jigs`
# makes them. They are ignored because a tracked symlink stores its target path
# as content, so committing one encodes where ../toolbox happens to sit and
# hands a clone six paths that resolve to nothing.
#
# Named one at a time rather than as `bolt.*.yaml`, because that glob would also
# swallow `bolt.wrench-quality.yaml` and `bolt.wrench.definitions.yaml`, which
# are this repository's own files and are tracked.
#
# `bin/` cannot be ignored wholesale for the same reason: it holds wrench's own
# checkers beside the links, so each link is named.
bolt.common-quality.yaml
bolt.cpp-std-quality.yaml
bolt.go-std-quality.yaml
bolt.python-std-quality.yaml
bolt.secrets.yaml
adapters/
config/
bin/clang-format-check.py
bin/suppression-register.py
bin/test-traceability.py
bin/voice-review.py
bin/voice-tells.py
