{
  "name": "@scriptedworld/wrench",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "exports": "./src/mod.ts",
  "imports": {
    "js-yaml": "npm:js-yaml@5.4.1",
    "ajv": "npm:ajv@8.20.0",
    "ajv/2020": "npm:ajv@8.20.0/dist/2020.js",
    "@std/assert": "jsr:@std/assert@^1.0.15"
  },
  "tasks": {
    "test": "deno test --allow-read --allow-write --allow-env",
    "check": "deno check src/mod.ts test/wrench_test.ts bin/generate_shipped.ts",
    "lint": "deno lint",
    "fmt": "deno fmt --check",
    "shipped": "deno run --allow-read --allow-write bin/generate_shipped.ts",
    "shipped:check": "deno run --allow-read bin/generate_shipped.ts --check"
  },
  "exclude": [
    "node_modules"
  ],
  "fmt": {
    "exclude": [
      "src/shipped.ts"
    ]
  }
}
