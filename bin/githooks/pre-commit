#!/usr/bin/env bash
# Refuse a commit carrying a suppression pragma SUPPRESSIONS does not name.
#
# Hard rule 4: a pragma needs a person to have answered why before it is
# written. A gate checks it when somebody runs the gate; this runs at the moment
# the pragma would land, which is the only point at which it cannot be
# forgotten.
#
# Install once per checkout, from the repository root:
#
#     ln -sf ../../bin/githooks/pre-commit .git/hooks/pre-commit.local
#
# `.local` and not `pre-commit`, because `core.hooksPath` in ~/.gitconfig sends
# git to ~/.git-hooks and git consults exactly one hooks directory. A hook
# installed as `.git/hooks/pre-commit` is never read: no error, no warning, and
# the only way to learn it is inert is to watch it fail to refuse something.
#
# The global `pre-commit` there is a dispatch that runs
# `$(git rev-parse --git-dir)/hooks/pre-commit.local` if it is executable, which
# is what makes a per-repository hook possible at all.
#
# Do not set core.hooksPath in this repository. A local override shadows the
# global directory, so the no-AI-attribution commit-msg hook and anything added
# there later would silently stop running here.
set -uo pipefail

root="$(git rev-parse --show-toplevel)"

checker="$root/bin/no-unregistered-suppression.py"

# The refusal message below asserts a cause, so establish it first. Otherwise
# any non-zero exit (a missing python3, a crashed checker, a partial checkout)
# tells somebody to register a pragma they never wrote and sends them looking in
# the wrong place.
if [ ! -f "$checker" ]; then
    echo "pre-commit: cannot run, $checker is missing." >&2
    exit 1
fi

if ! command -v python3 >/dev/null 2>&1; then
    echo "pre-commit: cannot run, python3 is not on PATH." >&2
    exit 1
fi

python3 "$checker"
status=$?

if [ "$status" -eq 1 ]; then
    echo
    echo "pre-commit: refused. Register it in SUPPRESSIONS with the question and"
    echo "the answer, or remove it. --no-verify is not the way through: it is the"
    echo "one option whose whole purpose is to suppress the check that stopped you."
    exit 1
fi

if [ "$status" -ne 0 ]; then
    echo "pre-commit: the checker exited $status, which is not a verdict." >&2
    echo "That is a fault in the check rather than in your commit." >&2
    exit 1
fi

# The wording check over what is being committed, and nothing else.
#
# With no mode given it reads the staged copies from the index rather than the
# working tree, so a partly staged file is judged by what is about to land. It
# reads no commits in this mode, which is what makes it usable here: the same
# checker under `--all-files` reads every commit in the history and this
# repository has 254 findings waiting in its own, which is `prose-cleanup/30` to
# `50` and not a reason to refuse the commit in front of you.
#
# Test this by attempting a real commit, never by running this file by hand.
# Hard rule 2 has us commit with `git commit <paths>` and never stage, so the
# index is empty between commits and a hand-run hook reports "0 staged files" and
# exits 0 whatever the file says. `git commit <paths>` builds a temporary index
# for those paths and points the hook at it, which is the only state in which
# this check sees anything.
wording="$root/bin/voice-tells.py"

if [ ! -e "$wording" ]; then
    echo "pre-commit: cannot run, $wording is missing." >&2
    echo "It is a link into toolbox, made by link-toolbox.py." >&2
    exit 1
fi

python3 "$wording"
status=$?

if [ "$status" -eq 1 ]; then
    echo
    echo "pre-commit: refused on the wording above. Reword it, or where the line is"
    echo "right as it stands, accept that one finding in .voice-baseline.json with"
    echo "the reason it stands. An entry carrying no reason accepts nothing."
    exit 1
fi

if [ "$status" -ne 0 ]; then
    echo "pre-commit: the wording check exited $status, which is not a verdict." >&2
    echo "That is a fault in the check rather than in your commit." >&2
    exit 1
fi

exit 0
