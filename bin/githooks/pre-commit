#!/usr/bin/env bash
# Refuse a commit carrying a suppression pragma SUPPRESSIONS does not name.
#
# Hard rule 4: a pragma needs a person to have answered why before it is
# written. A gate checks it when somebody runs the gate; this runs at the moment
# the pragma would land, which is the only point at which it cannot be
# forgotten.
#
# INSTALL, once per checkout, from the repository root:
#
#     ln -sf ../../bin/githooks/pre-commit .git/hooks/pre-commit.local
#
# `.local` and not `pre-commit`, because `core.hooksPath` in ~/.gitconfig sends
# git to ~/.git-hooks and git consults exactly one hooks directory. A hook
# installed as `.git/hooks/pre-commit` is never read: no error, no warning, and
# the only way to learn it is inert is to watch it fail to refuse something.
#
# The global `pre-commit` there is a dispatch that runs
# `$(git rev-parse --git-dir)/hooks/pre-commit.local` if it is executable, which
# is what makes a per-repository hook possible at all.
#
# THIS REPOSITORY USED TO SET core.hooksPath ITSELF, before that dispatch
# existed, and forwarded commit-msg beside this file so the no-AI-attribution
# gate kept running. Both are gone: the override shadowed the global directory,
# so anything added there stopped running here silently. Do not reintroduce it.
set -uo pipefail

root="$(git rev-parse --show-toplevel)"

if ! python3 "$root/bin/no-unregistered-suppression.py"; then
    echo
    echo "pre-commit: refused. Register it in SUPPRESSIONS with the question and"
    echo "the answer, or remove it. --no-verify is not the way through: it is the"
    echo "one option whose whole purpose is to suppress the check that stopped you."
    exit 1
fi

exit 0
